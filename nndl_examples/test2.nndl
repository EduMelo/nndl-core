steps:
  - name: storeCookies
    elements:
      - name: loginMark
        matchExp: '#USER_DROPDOWN_ID #email-collection-tooltip-id svg'
    actions:
      - storeCookies:
          storer: dev.edumelo.grfnkl.socialplataforms.services.reddit.RedditUserCookiesStorer
          landmarkConditions: 
            - element: loginMark
          storerParams:
            - ${userHandle}

  - name: bootstrap
    elements:
      - name: inputLogin
        matchExp: '#loginUsername'
      - name: loginMark
        matchExp: '#USER_DROPDOWN_ID #email-collection-tooltip-id svg'
    actions:
      - gotoUrl: https://www.reddit.com/settings/
        landmarkConditions: 
          - element: inputLogin
      - loadCookies: 
          retriever: dev.edumelo.grfnkl.socialplataforms.services.reddit.RedditUserCookiesRetriever
          retrieverParams:
            - ${userHandle}
      - gotoUrl: https://www.reddit.com/settings/
        landmarkConditions:
          - cooldown: 15000
      - gotoUrl: https://www.reddit.com/settings/
        forkElement: 
          - element: loginMark
            fork: loginSuccessfull
          - element: inputLogin
            fork: login

  - name: login
    elements:
      - name: inputLogin
        matchExp: '#loginUsername'
      - name: inputPassword
        matchExp: '#loginPassword'
      - name: submitButton
        matchExp: '.AnimatedForm__submitButton'
      - name: loginButton
        matchExp: "a[href^='https://www.reddit.com/login']"
      - name: loginMark
        matchExp: '#USER_DROPDOWN_ID #email-collection-tooltip-id svg'
      - name: invalidLogin
        matchExp: 'fieldset.m-invalid'
    actions:
      - gotoUrl: https://www.reddit.com/login
        landmarkConditions:
          - element: inputLogin
      - fillInput:
          input: inputLogin
          value: '${userHandle}'
        landmarkConditions:
          - element: inputLogin
      - fillInput:
          input: inputPassword
          value: '${userPassword}'
        landmarkConditions:
          - element: inputPassword
      - elementClick: submitButton
        timeout: 200
        forkElement:
          - element: loginMark
            fork: loginSuccessfull