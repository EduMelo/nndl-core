entryStep: main

steps:
  - name: main
    elements:
      - name: dolar
        matchExp: "#root h2"
    actions:
      - gotoUrl: "https://site.nomadglobal.com/lps/currency-converter/?currency=USD&initialValue=100&history=true"
        landmarkConditions:
          - element: dolar
      - extract: dev.edumelo.grfnkl.service.ValueFactory
        targertElement: dolar